# =============================================================================
# Dataverse JSF Tests — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored and will never be committed.

# -----------------------------------------------------------------------------
# Base URL (no trailing slash)
# -----------------------------------------------------------------------------
# The single endpoint the entire suite will run against.
BASE_URL=https://your-dataverse.example.edu

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------
#   DV_USERNAME  — username or email for the Dataverse account
#   DV_PASSWORD  — password for the Dataverse account
#   DV_FULL_NAME — display name shown in the Dataverse navbar after login
#                  (used to detect an existing authenticated session)
DV_USERNAME=your-username
DV_PASSWORD=your-password
DV_FULL_NAME=Your Full Name

# -----------------------------------------------------------------------------
# Login Adapter
# -----------------------------------------------------------------------------
# Select the authentication flow for this endpoint.
#
#   builtin                  — Dataverse built-in username / password form
#   shibboleth-direct        — IdP dropdown (#idpSelectSelector) on the
#                              Dataverse login page
#   incommon-seamlessaccess  — InCommon / SeamlessAccess waypoint flow
LOGIN_ADAPTER=builtin

# -----------------------------------------------------------------------------
# Collection to work in (optional)
# -----------------------------------------------------------------------------
# Every test creates its own uniquely-named child collections and datasets
# inside this collection and deletes them afterwards. The test account must be
# allowed to add collections and datasets here.
# Default: /dataverse/root  (a stock Dataverse install's top-level collection)
# ROOT_DATAVERSE=/dataverse/root

# -----------------------------------------------------------------------------
# Single sign-on options (required only by the matching adapter)
# -----------------------------------------------------------------------------
# shibboleth-direct: the <option> value (IdP entity ID) to pick in
# #idpSelectSelector
# IDP_SELECTOR_VALUE=https://idp.example.edu/idp/shibboleth

# incommon-seamlessaccess: text to type into the SeamlessAccess search box
# INCOMMON_INSTITUTION_SEARCH=example university

# incommon-seamlessaccess: accessible name (or part of it) of the institution
# result to click
# INCOMMON_INSTITUTION_LINK=Example University

# -----------------------------------------------------------------------------
# Optional Dataverse features (optional)
# -----------------------------------------------------------------------------
# Tests that need a feature not present on every deployment skip themselves
# unless the matching flag is "true".
#
# Custom Dataset Terms — tests/datasets/default-custom-license.spec.ts
# CUSTOM_LICENSE_ENABLED=true
#
# Locally FAIR — tests/datasets/locally-fair-download.spec.ts
# LOCALLY_FAIR_ENABLED=true

# -----------------------------------------------------------------------------
# Speed (optional)
# -----------------------------------------------------------------------------
# Milliseconds Playwright pauses between actions. Default: 2000.
# Set to 0 for fast local iteration against a responsive instance.
# SLOW_MO=0
